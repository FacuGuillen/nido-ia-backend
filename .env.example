# OpenAI provider configuration
# Replace with your actual OpenAI API key at runtime; never commit the real value.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=your-openai-model-here

# PostgreSQL database configuration
NIDO_DB_HOST=localhost
NIDO_DB_PORT=5432
NIDO_DB_NAME=nido
NIDO_DB_USER=root
# Replace with the real database password at runtime; never commit the real value.
NIDO_DB_PASSWORD=your-db-password-here

# Application server port
APP_PORT=5000
